{
  "expo": {
    "name": "GlycoTrack",
    "slug": "glycotrack",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "glycotrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.glycotrack.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "GlycoTrack uses Face ID to lock your health information if you turn on App lock."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "android": {
      "package": "com.glycotrack.app",
      "adaptiveIcon": {
        "backgroundColor": "#3451D1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6FA",
          "dark": {
            "backgroundColor": "#0A0E17"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3451D1"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "GlycoTrack uses Face ID to lock your health information if you turn on App lock."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
